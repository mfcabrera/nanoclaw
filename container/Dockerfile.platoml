# NanoClaw Agent Container — PlatoML variant
# Extends the base agent image with Miniforge (Python 3.12) and Databricks CLI
# for working with the PlatoML repository.
#
# The platoml repo is NOT baked in — mount it at runtime via
# containerConfig.additionalMounts.

FROM nanoclaw-agent:latest

USER root

# Install miniforge (conda-forge native — no Anaconda ToS)
ENV CONDA_DIR=/opt/conda
RUN curl -fsSL https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh -o /tmp/miniforge.sh \
    && bash /tmp/miniforge.sh -b -p $CONDA_DIR \
    && rm /tmp/miniforge.sh \
    && $CONDA_DIR/bin/conda clean -afy

ENV PATH="$CONDA_DIR/bin:$PATH"

# Create platoml environment with Python 3.12
RUN conda create -n platoml python=3.12 -y && conda clean -afy

# Install build tools, GitHub CLI, fd-find, and Java (for PySpark)
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gh \
    fd-find \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# Install ast-grep (Claude Code search tool) via npm
RUN npm install -g @ast-grep/cli

# Install packages in the platoml environment
# Core platoml deps + Databricks tooling + test dependencies
# Versions pinned from platoml/environment.yml where available
SHELL ["conda", "run", "-n", "platoml", "/bin/bash", "-c"]
RUN pip install --no-cache-dir \
    databricks-cli \
    databricks-sdk==0.14.0 \
    databricks-sql-connector \
    pydantic==2.6.1 \
    pyyaml==6.0.1 \
    jinja2==3.1.2 \
    ruff==0.12.5 \
    pandas==2.1.3 \
    numpy==1.26.2 \
    pyarrow==14.0.1 \
    requests==2.31.0 \
    tabulate==0.9.0 \
    pyspark==3.5.4 \
    mlflow==2.14.0 \
    pytest==8.0.0 \
    pytest-cov==6.2.1 \
    scipy==1.12.0 \
    sparkdantic==1.4.0 \
    implicit==0.7.2 \
    tqdm==4.66.1 \
    datasketch==1.6.4 \
    babel==2.13.1 \
    jaro-winkler==2.0.3 \
    coverage==7.10.0 \
    "setuptools<80"

# Make the platoml conda env the default for all shells
SHELL ["/bin/bash", "-c"]
RUN echo "conda activate platoml" >> /etc/profile.d/conda.sh \
    && echo "conda activate platoml" >> /home/node/.bashrc

# Ensure conda and the platoml env are on PATH for non-interactive shells
ENV PATH="$CONDA_DIR/envs/platoml/bin:$CONDA_DIR/bin:$PATH"
ENV CONDA_DEFAULT_ENV=platoml

# Create .databrickscfg directory (will be written at runtime by agent-runner)
RUN mkdir -p /home/node/.databricks && chown node:node /home/node/.databricks

# Switch back to non-root user
USER node
